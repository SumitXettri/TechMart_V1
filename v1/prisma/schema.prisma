generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("customer")
  createdAt DateTime @default(now())
}

model Product {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  name        String
  brand       String
  category    String
  description String
  createdAt   DateTime         @default(now())
  variants    ProductVariant[]
}

model ProductVariant {
  id         Int                @id @default(autoincrement())
  productId  Int
  sku        String             @unique
  price      Decimal            @default(0)
  stock      Int                @default(0)
  isActive   Boolean            @default(true)
  metadata   String?
  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes VariantAttribute[]
  auctions   Auction[]

  @@index([productId, isActive])
}

model VariantAttribute {
  id        Int            @id @default(autoincrement())
  variantId Int
  name      String
  value     String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([name, value])
}

model Auction {
  id                  Int      @id @default(autoincrement())
  productVariantId    Int
  currentHighestBid   Decimal  @default(0)
  minBidIncrement     Decimal  @default(0)
  totalBids           Int      @default(0)
  version             Int      @default(0)
  endTime             DateTime
  winnerAnonymized    String?
  status              String   @default("live")
  productVariant      ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId, status])
  @@index([version])
}

model Order {
  id                    Int      @id @default(autoincrement())
  userId                Int?
  paymentReference      String
  paymentGateway        String
  gatewayTrackingKey    String?
  total                 Decimal  @default(0)
  status                String   @default("pending")
  createdAt             DateTime @default(now())

  @@index([paymentGateway, paymentReference])
  @@index([gatewayTrackingKey])
}
